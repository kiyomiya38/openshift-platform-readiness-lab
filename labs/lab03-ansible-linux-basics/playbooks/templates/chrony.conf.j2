# Managed by Ansible for a disposable training VM.
# NTP sources are environment-dependent and must be reviewed before use.
{% for server in chrony_servers %}
pool {{ server }} iburst
{% endfor %}

driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
keyfile /etc/chrony.keys
leapsectz right/UTC
logdir /var/log/chrony
