    DNS["DNS pair<br/>192.0.2.2 / .3<br/>UDP/TCP 53"]:::network
    NTP["NTP pair<br/>192.0.2.4 / .5<br/>UDP 123"]:::network

    subgraph LB["外部LB pair 192.0.2.12 / .13"]
