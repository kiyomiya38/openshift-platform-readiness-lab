# Managed by Ansible for {{ cluster_domain }}. Do not edit on the host.
global
  log         127.0.0.1 local2
  pidfile     /run/haproxy.pid
  maxconn     4000
  daemon

defaults
  mode                    tcp
  log                     global
  option                  dontlognull
  option                  redispatch
  retries                 3
  timeout connect         10s
  timeout client          1m
  timeout server          1m
  timeout check           10s
  maxconn                 3000

listen api-server-6443
  bind *:6443
  mode tcp
  balance roundrobin
  option httpchk GET /readyz HTTP/1.0
  http-check expect status 200
{% for backend in control_plane_backends %}
  server {{ backend.name }} {{ backend.host }}:6443 check check-ssl verify none inter 5s fall 3 rise 2
{% endfor %}

listen machine-config-server-22623
  bind *:22623
  mode tcp
  balance roundrobin
{% for backend in control_plane_backends %}
  server {{ backend.name }} {{ backend.host }}:22623 check inter 5s fall 3 rise 2
{% endfor %}

listen ingress-router-443
  bind *:443
  mode tcp
  balance source
{% for backend in worker_backends %}
  server {{ backend.name }} {{ backend.host }}:443 check inter 5s fall 3 rise 2
{% endfor %}

listen ingress-router-80
  bind *:80
  mode tcp
  balance source
{% for backend in worker_backends %}
  server {{ backend.name }} {{ backend.host }}:80 check inter 5s fall 3 rise 2
{% endfor %}

