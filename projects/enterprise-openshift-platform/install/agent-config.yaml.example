        config:
          - destination: 0.0.0.0/0
            next-hop-address: 192.0.2.1
            next-hop-interface: enp1s0
            table-id: 254
  - hostname: wk01.ocp-prd.example.com
    role: worker
    interfaces:
      - name: enp1s0
        macAddress: 02:00:00:00:00:31
    rootDeviceHints:
      deviceName: /dev/sda
    networkConfig:
      interfaces:
        - name: enp1s0
          type: ethernet
          state: up
          mac-address: 02:00:00:00:00:31
          mtu: 1500
          ipv4:
            enabled: true
            address:
              - ip: 192.0.2.31
                prefix-length: 24
            dhcp: false
          ipv6:
            enabled: false
      dns-resolver:
        config:
          server: [192.0.2.2, 192.0.2.3]
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: 192.0.2.1
            next-hop-interface: enp1s0
            table-id: 254
