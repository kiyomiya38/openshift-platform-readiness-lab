# Example for lb02 (192.0.2.13). Interface name must be confirmed.
global_defs {
  enable_script_security
  script_user root
}

vrrp_script chk_haproxy {
  script "/usr/bin/pgrep -x haproxy"
  interval 2
  fall 2
  rise 2
  weight -20
}

vrrp_instance VI_OCP {
  state BACKUP
  interface enp1s0
  virtual_router_id 51
  priority 100
  advert_int 1
  unicast_src_ip 192.0.2.13
  unicast_peer {
    192.0.2.12
  }
  virtual_ipaddress {
    192.0.2.10/24 dev enp1s0
    192.0.2.11/24 dev enp1s0
  }
  track_script {
    chk_haproxy
  }
}

