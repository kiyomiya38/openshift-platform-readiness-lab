# HAProxy example for both external LB nodes. VIP ownership is handled by the
# separately reviewed keepalived example. Validate with: haproxy -c -f <file>
global
  log         127.0.0.1 local2
  pidfile     /run/haproxy.pid
  maxconn     4000
  daemon

defaults
  mode                    tcp
  log                     global
  option                  dontlognull
  option                  redispatch
  retries                 3
  timeout connect         10s
  timeout client          1m
  timeout server          1m
  timeout check           10s
  maxconn                 3000

# API load balancing must be stateless. The HTTPS health check uses /readyz;
# fall 3 marks a backend down after three consecutive failed checks. The exact
# detection time also depends on scheduling and timeout behavior.
listen api-server-6443
  bind *:6443
  mode tcp
  balance roundrobin
  option httpchk GET /readyz HTTP/1.0
  http-check expect status 200
  server cp01 cp01.ocp-prd.example.com:6443 check check-ssl verify none inter 5s fall 3 rise 2
  server cp02 cp02.ocp-prd.example.com:6443 check check-ssl verify none inter 5s fall 3 rise 2
  server cp03 cp03.ocp-prd.example.com:6443 check check-ssl verify none inter 5s fall 3 rise 2

listen machine-config-server-22623
  bind *:22623
  mode tcp
  balance roundrobin
  server cp01 cp01.ocp-prd.example.com:22623 check inter 5s fall 3 rise 2
  server cp02 cp02.ocp-prd.example.com:22623 check inter 5s fall 3 rise 2
  server cp03 cp03.ocp-prd.example.com:22623 check inter 5s fall 3 rise 2

listen ingress-router-443
  bind *:443
  mode tcp
  balance source
  server wk01 wk01.ocp-prd.example.com:443 check inter 5s fall 3 rise 2
  server wk02 wk02.ocp-prd.example.com:443 check inter 5s fall 3 rise 2
  server wk03 wk03.ocp-prd.example.com:443 check inter 5s fall 3 rise 2

listen ingress-router-80
  bind *:80
  mode tcp
  balance source
  server wk01 wk01.ocp-prd.example.com:80 check inter 5s fall 3 rise 2
  server wk02 wk02.ocp-prd.example.com:80 check inter 5s fall 3 rise 2
  server wk03 wk03.ocp-prd.example.com:80 check inter 5s fall 3 rise 2
